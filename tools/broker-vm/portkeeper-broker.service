[Unit]
Description=Portkeeper build broker (rootless Docker workers)
After=docker.service network-online.target
Wants=network-online.target

[Service]
EnvironmentFile=%h/portkeeper-broker/broker.env
WorkingDirectory=%h/portkeeper-broker/current
ExecStart=/usr/bin/python3 -m portkeeper.worker_broker --root ${BROKER_ROOT} --input-root ${INPUT_ROOT} --listen ${LISTEN} --image ${WORKER_IMAGE_ID}
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
